# ═══════════════════════════════════════════════════════════
# RossTrader_US — 미국 주식 매매 프로그램 환경 변수
# ═══════════════════════════════════════════════════════════

# ── 한국투자증권(KIS) API (모의투자/실전) ──────────────
# KIS 모의투자: https://openapivts.koreainvestment.com:29443
# KIS 실전투자: https://openapi.koreainvestment.com:9443
# API 키 발급: https://apiportal.koreainvestment.com → 앱키 발급
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT_NO=your_account_no_here     # 8자리-2자리 (예: 12345678-01)
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_IS_REAL=false
KIS_EXCHANGE=NASD

# ── 미국 시장 기본 설정 ───────────────────────────────────
US_DEFAULT_EXCHANGE=NASD     # NASD / NYSE / AMEX
USD_KRW_FALLBACK=1350.0      # 환율 (API 실패 시 사용)

# ── 리스크 파라미터 (USD 기준) ────────────────────────────
US_MAX_ORDER_USD=500.0
US_MAX_PORTFOLIO_PCT=0.40
US_STOP_LOSS_PCT=2.0
US_TAKE_PROFIT_PCT=3.5
US_TRAILING_STOP_PCT=1.0

# ── 뉴스 수집 ─────────────────────────────────────────────
FINNHUB_API_KEY=your_finnhub_api_key_here

# ── Telegram 알림 (선택) ──────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── 웹 모니터 (선택) ──────────────────────────────────────
WEB_MONITOR_PORT=5000
WEB_MONITOR_PASSWORD=
NGROK_TOKEN=
